# =================================================================
# KNEEAXIS PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# AI-Assisted 3D Knee MRI Segmentation & Reconstruction (Research Prototype)
# =================================================================

# -----------------------------------------------------------------
# 1. Server & Networking
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------
# 2. Authentication & Cryptography
# NOTE: In production (NODE_ENV=production), JWT_SECRET must be at
# least 32 characters long with letters, digits, and special characters.
# Never commit real keys or secrets to version control.
# -----------------------------------------------------------------
JWT_SECRET=GENERATE_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
SESSION_EXPIRY_DAYS=7
SESSION_EXPIRY_REMEMBER_DAYS=30

# -----------------------------------------------------------------
# 3. Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# In production, explicit DATABASE_URL is strictly required.
# In development/test mode, omit or use test engine.
# -----------------------------------------------------------------
DATABASE_URL=postgresql://kneeaxis_user:CONFIGURE_STRONG_PASSWORD_PRIVATELY@localhost:5432/kneeaxis_db

# -----------------------------------------------------------------
# 4. Storage Directories (relative to workspace root or absolute)
# -----------------------------------------------------------------
UPLOAD_DIR=../uploads
OUTPUT_DIR=../outputs

# -----------------------------------------------------------------
# 5. Python Environment & Execution Timeout
# Point to Python interpreter with SimpleITK, scikit-image, Trimesh, PyTorch
# -----------------------------------------------------------------
PYTHON_PATH=E:\KneeAxis_Datasets\nnUNet\.venv\Scripts\python.exe
PYTHON_TIMEOUT_MS=180000

# -----------------------------------------------------------------
# 6. Active nnU-Net v2 Research Pipeline Configurations
# Evaluated on 24 complete MRI scans with full-volume mean Dice: 0.7477
# -----------------------------------------------------------------
NNUNET_MODEL_REGISTRY=E:\KneeAxis_Datasets\nnUNet\KneeAxis_model_registry.json
NNUNET_MODEL_FOLDER=E:\KneeAxis_Datasets\nnUNet\nnUNet_results\Dataset922_OAIZIBCM_KneeAxisFull\nnUNetTrainer__nnUNetPlans_KneeAxis3D_3G__3d_fullres\fold_0
NNUNET_RESULTS=E:\KneeAxis_Datasets\nnUNet\nnUNet_results
NNUNET_PYTHON=E:\KneeAxis_Datasets\nnUNet\.venv\Scripts\python.exe
RECONSTRUCTION_PYTHON=E:\KneeAxis_Datasets\nnUNet\.venv\Scripts\python.exe

# -----------------------------------------------------------------
# 7. Algorithmic & Research Pipeline Guards
# Keep false: Surgical cuts, mechanical axis, and planning are unvalidated
# -----------------------------------------------------------------
ENABLE_UNVALIDATED_PLANNING=false

# -----------------------------------------------------------------
# 8. Legacy / Auxiliary Script Paths (Readiness Status: Not Trained)
# -----------------------------------------------------------------
KL_SCRIPT_PATH=../ml/inference/predict_kl.py
KL_WEIGHTS=../models/kl_classifier/best.weights.h5
KL_CONFIG=../models/kl_classifier/model_config.json

SEGMENTATION_SCRIPT_PATH=../ml/inference/predict_segmentation.py
SEGMENTATION_WEIGHTS=../models/knee_segmentation/best.weights.h5

RECONSTRUCTION_SCRIPT_PATH=../reconstruction3d/reconstruct_3d.py
RECONSTRUCTION_LABELS=../reconstruction3d/labels.json
